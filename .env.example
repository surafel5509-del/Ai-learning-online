# ---- AI Platform environment configuration ----
# Copy to .env and adjust before deploying.

# PostgreSQL
POSTGRES_PASSWORD=changeme

# Auth / JWT
SECRET_KEY=please-change-this-secret

# Database (used when not running via docker-compose)
DATABASE_URL=sqlite:///data/ai_platform.db
# For PostgreSQL: postgresql+psycopg2://aiplatform:changeme@localhost:5432/aiplatform

# Redis (for task queue coordination)
REDIS_URL=redis://localhost:6379/0

# Object / file storage root
STORAGE_DIR=./data

# CORS
CORS_ORIGINS=*

# Hardware preference for new jobs: AUTO | CPU | GPU
DEFAULT_DEVICE=CPU
